<div class="vote">
    <div class="vote__header">
        <h2>¿Qué hacemos el día flexible?</h2>
        <p class="vote__subtitle">
            31 de octubre · Puedes cambiar tu voto cuando quieras
        </p>
    </div>

    <div id="vote-options" class="vote__options"></div>
</div>

<style is:global>
    .vote {
        padding: 1.25rem;
        background: white;
        border: 1px solid #e2e2e2;
        border-radius: 12px;
        margin-bottom: 1.5rem;
    }
    .vote__header {
        margin-bottom: 1.25rem;
    }
    .vote__header h2 {
        margin: 0 0 0.2rem;
    }
    .vote__subtitle {
        margin: 0;
        font-size: 0.8rem;
        color: #78716c;
    }

    .vote__options {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .vote__option {
        border: 1px solid #e2e2e2;
        border-radius: 10px;
        padding: 0.85rem 1rem;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        transition: border-color 0.15s ease;
    }
    .vote__option.selected {
        border-color: var(--color-rust);
        border-width: 2px;
        padding: calc(0.85rem - 1px) calc(1rem - 1px);
    }

    .vote__option-bar {
        position: absolute;
        top: 0;
        left: 0;
        bottom: 0;
        background: var(--color-sand);
        z-index: 0;
        transition: width 0.4s ease;
    }

    .vote__option-content {
        position: relative;
        z-index: 1;
    }

    .vote__option-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
    }

    .vote__option-label {
        font-weight: 600;
        font-size: 0.92rem;
        color: var(--color-navy);
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }
    .vote__option-check {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: var(--color-rust);
        color: white;
        font-size: 0.65rem;
        flex-shrink: 0;
    }

    .vote__option-pct {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--color-navy);
    }

    .vote__option-bottom {
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .vote__voters {
        display: flex;
    }
    .vote__voters img {
        width: 24px;
        height: 24px;
        min-width: 24px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid white;
        margin-left: -8px;
        display: block;
    }
    .vote__voters img:first-child {
        margin-left: 0;
    }

    .vote__no-votes {
        font-size: 0.75rem;
        color: #a8a29e;
    }
</style>

<script>
    import { supabase, subscribeToTable } from "../lib/supabase";
    import { avatarOf, getCurrentUser } from "../utils/identity";

    // Opciones fijas, basadas en las ideas de la infografía para el día flexible.
    // Edita este array libremente si queréis añadir/quitar opciones.
    const OPTIONS = [
        "Compras en Citadel Outlets",
        "Repetir un sitio favorito del viaje",
        "Plan Halloween por Los Ángeles",
        "Día de piscina/relax en el hotel",
        "Explorar un barrio nuevo de LA",
    ];

    const optionsDiv = document.getElementById("vote-options")!;

    type VoteRow = { participant: string; option: string };

    let votes: VoteRow[] = [];

    function render() {
        const currentUser = getCurrentUser();
        const myVote = votes.find((v) => v.participant === currentUser)?.option;
        const totalVotes = votes.length;

        optionsDiv.innerHTML = OPTIONS.map((option) => {
            const voters = votes
                .filter((v) => v.option === option)
                .map((v) => v.participant);
            const count = voters.length;
            const pct =
                totalVotes > 0 ? Math.round((count / totalVotes) * 100) : 0;
            const isSelected = myVote === option;

            return `
        <div class="vote__option ${isSelected ? "selected" : ""}" data-option="${option}">
          <div class="vote__option-bar" style="width:${pct}%"></div>
          <div class="vote__option-content">
            <div class="vote__option-top">
              <span class="vote__option-label">
                ${isSelected ? '<span class="vote__option-check">✓</span>' : ""}
                ${option}
              </span>
              <span class="vote__option-pct">${count > 0 ? pct + "%" : ""}</span>
            </div>
            <div class="vote__option-bottom">
              ${
                  voters.length > 0
                      ? `<div class="vote__voters">${voters.map((v) => `<img src="${avatarOf(v)}" alt="${v}" title="${v}" />`).join("")}</div>`
                      : '<span class="vote__no-votes">Sin votos aún</span>'
              }
            </div>
          </div>
        </div>
      `;
        }).join("");
    }

    async function loadVotes() {
        const { data, error } = await supabase
            .from("flexible_day_votes")
            .select("*");
        if (error) {
            console.error("Error cargando votos:", error);
            return;
        }
        votes = (data ?? []) as VoteRow[];
        render();
    }

    optionsDiv.addEventListener("click", async (e) => {
        const optionEl = (e.target as HTMLElement).closest(
            ".vote__option",
        ) as HTMLElement;
        if (!optionEl) return;
        const option = optionEl.dataset.option!;
        const currentUser = getCurrentUser();
        if (!currentUser) return;

        const { error } = await supabase
            .from("flexible_day_votes")
            .upsert({
                participant: currentUser,
                option,
                voted_at: new Date().toISOString(),
            });

        if (error) console.error("Error votando:", error);
    });

    subscribeToTable("flexible_day_votes", loadVotes);

    loadVotes();
</script>
