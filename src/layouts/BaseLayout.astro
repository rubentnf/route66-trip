---
import TripStatus from "../components/TripStatus.astro";
import NavBar from "../components/NavBar.astro";

interface Props {
    title: string;
    hideNav?: boolean;
}
const { title, hideNav = false } = Astro.props;
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex, nofollow" />
        <title>{title} · Divas en Ruta</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&family=Work+Sans:wght@400;500;600&display=swap"
            rel="stylesheet"
        />

        <script is:inline>
            (function () {
                const isIdentityPage =
                    window.location.pathname.replace(/\/$/, "") ===
                    "/identidad";
                const hasUser = localStorage.getItem("trip-user");
                if (!hasUser && !isIdentityPage) {
                    sessionStorage.setItem(
                        "identity-redirect",
                        window.location.pathname,
                    );
                    window.location.replace("/identidad");
                }
            })();
        </script>
    </head>
    <body>
        <a href="/" class="site-title">
            <img src="/logo.png" alt="Divas en Ruta" class="site-logo" />
        </a>
        {!hideNav && <NavBar />}
        <TripStatus />
        <main>
            <slot />
        </main>
    </body>
</html>

<style is:global>
    :root {
        --color-sand: #f5ead3;
        --color-sand-dark: #e8d9b8;
        --color-navy: #1e293b;
        --color-rust: #c2410c;
        --color-turquoise: #0d9488;
        --color-mustard: #ca8a04;

        --font-display: "Oswald", sans-serif;
        --font-body: "Work Sans", sans-serif;
    }

    .site-title {
        display: flex;
        justify-content: center;
        padding: 1rem;
        background: var(--color-sand-dark);
        border-bottom: 4px solid var(--color-rust);
    }
    .site-logo {
        height: 20vh;
        width: auto;
        cursor: pointer;
    }

   /*  @media (max-width: 600px) {
        .site-logo {
            height: 80px;
        }
    } */

    body {
        background: var(--color-sand);
        color: var(--color-navy);
        font-family: var(--font-body);
        margin: 0;
    }

    h1,
    h2,
    h3 {
        font-family: var(--font-display);
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    h1 {
        padding: 1.5rem;
        margin: 0;
        color: var(--color-rust);
        border-bottom: 4px solid var(--color-rust);
        background: var(--color-sand-dark);
    }

    main {
        padding: 0 1rem 2rem;
    }

    body.theme-vegas {
        --color-sand: #0f0a1e;
        --color-sand-dark: #1a1030;
        --color-navy: #f5f0ff;
        --color-rust: #ff2d95;
        --color-turquoise: #00e5ff;
        --color-mustard: #ffd60a;
        transition:
            background 0.6s ease,
            color 0.6s ease;
    }
    body.theme-vegas h1 {
        text-shadow: 0 0 12px var(--color-rust);
    }
</style>
