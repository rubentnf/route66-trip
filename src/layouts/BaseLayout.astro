---
import { Image } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import TripStatus from "../components/TripStatus.astro";
import NavBar from "../components/NavBar.astro";
import logo from "../assets/logo.png";
import { describe } from "astro:schema";

interface Props {
    title: string;
    hideNav?: boolean;
    hideLogo?: boolean;
    hideStatus?: boolean;
}
const {
    title,
    hideNav = false,
    hideLogo = false,
    hideStatus = false,
} = Astro.props;

const pageTitle = `${title} · Divas en Ruta`;
const description =
    "Nuestro viaje por la Ruta 66: itinerario, mapa, paylist y más - Rubén, Stephie y Saray, 17 oct - 1 nov 2026.";
const ogImage = new URL("/og-image.png", Astro.site ?? Astro.url).href;
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex, nofollow" />

        <meta property="og:type" content="website" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:url" content={Astro.url.href} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        <title>{title} · Divas en Ruta</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="manifest" href="/manifest.webmanifest" />
        <meta name="theme-color" content="#c2410c" />
        <link
            href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&family=Anton&family=Work+Sans:wght@400;500;600&display=swap"
            rel="stylesheet"
        />
        <ClientRouter />

        <script is:inline>
            if ("serviceWorker" in navigator) {
                window.addEventListener("load", () => {
                    navigator.serviceWorker
                        .register("/sw.js")
                        .catch((err) =>
                            console.warn(
                                "No se pudo registrar el service worker",
                                err,
                            ),
                        );
                });
            }

            (function () {
                const isIdentityPage =
                    window.location.pathname.replace(/\/$/, "") ===
                    "/identidad";
                const hasUser = localStorage.getItem("trip-user");
                if (!hasUser && !isIdentityPage) {
                    sessionStorage.setItem(
                        "identity-redirect",
                        window.location.pathname,
                    );
                    window.location.replace("/identidad");
                }
            })();
        </script>
    </head>
    <body>
        {
            !hideLogo && (
                <a href="/" class="site-title">
                    <Image
                        src={logo}
                        alt="Divas en Ruta"
                        class="site-logo"
                        width={700}
                        loading="eager"
                        fetchpriority="high"
                    />
                </a>
            )
        }
        {!hideNav && <NavBar />}
        {!hideStatus && <TripStatus />}
        <main>
            <slot />
        </main>
    </body>
</html>

<style is:global>
    :root {
        --color-sand: #f5ead3;
        --color-sand-dark: #e8d9b8;
        --color-navy: #1e293b;
        --color-rust: #c2410c;
        --color-turquoise: #0d9488;
        --color-mustard: #ca8a04;

        --font-display: "Oswald", sans-serif;
        --font-body: "Work Sans", sans-serif;
    }

    .site-title {
        display: flex;
        justify-content: center;
        padding: 1rem;
        background: var(--color-sand-dark);
        border-bottom: 4px solid var(--color-rust);
    }
    .site-logo {
        height: 20vh;
        width: auto;
        cursor: pointer;
    }

    body {
        background: var(--color-sand);
        color: var(--color-navy);
        font-family: var(--font-body);
        margin: 0;
        transition:
            background 0.6s ease,
            color 0.6s ease;
    }

    h1,
    h2,
    h3 {
        font-family: var(--font-display);
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    h1 {
        padding: 1.5rem;
        margin: 0;
        color: var(--color-rust);
        border-bottom: 4px solid var(--color-rust);
        background: var(--color-sand-dark);
    }

    main {
        padding: 0 1rem 2rem;
    }

    body[data-theme="vegas"] {
        --color-sand: #0f0a1e;
        --color-sand-dark: #1a1030;
        --color-navy: #f5f0ff;
        --color-rust: #ff2d95;
        --color-turquoise: #00e5ff;
        --color-mustard: #ffd60a;
    }
    body[data-theme="vegas"] h1 {
        text-shadow: 0 0 12px var(--color-rust);
    }

    body[data-theme="desert"] {
        --color-sand: #fbe9d0;
        --color-sand-dark: #f0d3a0;
        --color-navy: #5c2e0f;
        --color-rust: #b83a1e;
        --color-turquoise: #c98a2c;
        --color-mustard: #e2a63c;
    }
</style>
