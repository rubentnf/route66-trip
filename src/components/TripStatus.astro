<div id="trip-status" class="trip-status"></div>

<style>
    .trip-status {
        padding: 1rem 1.5rem;
        border-radius: 12px;
        background: #f1f5f9;
        font-weight: 600;
        margin-bottom: 1rem;
    }
    .trip-status--live {
        background: #dcfce7;
        color: #166534;
    }
</style>

<script>
    import { mountPhaseWidget } from "../utils/tripDate";

    let stopWidget: (() => void) | undefined;

    document.addEventListener("astro:page-load", () => {
        const el = document.getElementById("trip-status");
        if (!el) return;

        stopWidget = mountPhaseWidget((phase) => {
            if (phase.status === "before") {
                el.textContent = `🗓️ Faltan ${phase.daysLeft} días para el viaje`;
                el.classList.remove("trip-status--live");
            } else if (phase.status === "during") {
                el.textContent = `📍 Hoy es el Día ${phase.today.id}: ${phase.today.title}`;
                el.classList.add("trip-status--live");
            } else {
                el.textContent = `✅ Viaje completado — ¡qué pasada!`;
                el.classList.remove("trip-status--live");
            }
        });
    });

    document.addEventListener("astro:before-swap", () => stopWidget?.());
</script>
