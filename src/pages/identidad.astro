---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="¿Qué diva eres?" hideNav={true}>
    <div class="identity-scene">
        <svg
            class="identity-scene__bg"
            viewBox="0 0 1000 500"
            preserveAspectRatio="none"
            aria-hidden="true"
        >
            <defs>
                <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#f8c88a"></stop>
                    <stop offset="55%" stop-color="#f2a35a"></stop>
                    <stop offset="100%" stop-color="#e8863c"></stop>
                </linearGradient>
            </defs>
            <rect width="1000" height="500" fill="url(#sky)"></rect>
            <circle cx="500" cy="230" r="70" fill="#fff3d6" opacity="0.85"
            ></circle>
            <path
                d="M0 340 L120 260 L230 320 L340 240 L480 320 L620 250 L760 330 L880 270 L1000 340 L1000 500 L0 500 Z"
                fill="#c2410c"
                opacity="0.55"></path>
            <path
                d="M0 400 L150 350 L300 400 L470 340 L650 400 L820 360 L1000 400 L1000 500 L0 500 Z"
                fill="#9a3412"
                opacity="0.75"></path>
        </svg>

        <span class="identity-scene__tumbleweed" aria-hidden="true">
            <svg viewBox="0 0 60 60" width="46" height="46">
                <g fill="none" stroke="#78350f" stroke-width="2" opacity="0.7">
                    <circle cx="30" cy="30" r="24"></circle>
                    <path d="M10 18 Q30 30 50 18"></path>
                    <path d="M10 42 Q30 30 50 42"></path>
                    <path d="M18 10 Q30 30 18 50"></path>
                    <path d="M42 10 Q30 30 42 50"></path>
                </g>
            </svg>
        </span>

        <svg
            class="identity-scene__cactus identity-scene__cactus--left"
            viewBox="0 0 60 100"
            aria-hidden="true"
        >
            <g fill="#166534">
                <rect x="24" y="20" width="12" height="80" rx="6"></rect>
                <rect x="6" y="40" width="12" height="35" rx="6"></rect>
                <rect x="42" y="30" width="12" height="45" rx="6"></rect>
            </g>
        </svg>
        <svg
            class="identity-scene__cactus identity-scene__cactus--right"
            viewBox="0 0 60 100"
            aria-hidden="true"
        >
            <g fill="#166534">
                <rect x="24" y="10" width="12" height="90" rx="6"></rect>
                <rect x="42" y="35" width="12" height="40" rx="6"></rect>
            </g>
        </svg>

        <div class="identity-picker">
            <div class="identity-picker__sign">
                <span class="identity-picker__star">★</span>
                <h2>¿Quién eres en esta aventura?</h2>
                <p class="identity-picker__subtitle">
                    Elige tu personaje para la Ruta 66
                </p>
            </div>

            <div id="identity-cards" class="identity-picker__cards"></div>
        </div>
    </div>
</BaseLayout>

<style is:global>
    .identity-scene {
        position: relative;
        overflow: hidden;
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .identity-scene__bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
    }

    .identity-scene__cactus {
        position: absolute;
        bottom: 4%;
        width: 70px;
        height: auto;
        z-index: 1;
        opacity: 0.9;
    }
    .identity-scene__cactus--left {
        left: 4%;
    }
    .identity-scene__cactus--right {
        right: 5%;
        bottom: 6%;
    }

    .identity-scene__tumbleweed {
        position: absolute;
        top: 68%;
        left: -60px;
        z-index: 1;
        animation: roll-across 14s linear infinite;
    }
    @keyframes roll-across {
        0% {
            transform: translateX(0) rotate(0deg);
        }
        100% {
            transform: translateX(calc(100vw + 120px)) rotate(720deg);
        }
    }

    .identity-picker {
        position: relative;
        z-index: 2;
        text-align: center;
        padding: 2rem 1rem 3rem;
        max-width: 780px;
    }

    .identity-picker__sign {
        background: #f5ead3;
        border: 4px solid #78350f;
        border-radius: 10px;
        padding: 1.25rem 1.5rem 1.5rem;
        margin-bottom: 2.5rem;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
        position: relative;
    }
    .identity-picker__star {
        display: inline-block;
        color: #c2410c;
        font-size: 1.4rem;
        margin-bottom: 0.25rem;
    }
    .identity-picker__sign h2 {
        margin: 0;
        color: #78350f;
    }
    .identity-picker__subtitle {
        color: #92400e;
        font-style: italic;
        margin: 0.4rem 0 0;
    }

    .identity-picker__cards {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 2.5rem;
    }

    .identity-card {
        width: 180px;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.7rem;
        position: relative;
    }

    .identity-card__frame {
        width: 170px;
        height: 170px;
        border-radius: 50%;
        padding: 6px;
        background: linear-gradient(145deg, #ffd700, #c2410c);
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.35);
        transition:
            transform 0.35s ease,
            box-shadow 0.35s ease;
        position: relative;
    }
    .identity-card__frame::before {
        content: "";
        position: absolute;
        inset: 5px;
        border-radius: 50%;
        border: 3px dashed rgba(255, 255, 255, 0.5);
        pointer-events: none;
    }

    .identity-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
        border: 4px solid #1e293b;
        display: block;
    }

    .identity-card:hover .identity-card__frame {
        transform: rotate(-4deg) scale(1.1);
        box-shadow: 0 10px 24px rgba(194, 65, 12, 0.5);
    }

    .identity-card__label {
        background: #f5ead3;
        border: 2px solid #78350f;
        border-radius: 8px;
        padding: 0.5rem 0.75rem;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.2);
    }

    .identity-card h3 {
        margin: 0;
        font-size: 1.15rem;
        color: #78350f;
    }
    .identity-card p {
        margin: 0.2rem 0 0;
        font-size: 0.78rem;
        color: #92400e;
        font-style: italic;
        max-width: 160px;
    }

    .identity-card__badge {
        position: absolute;
        top: -10px;
        right: 14px;
        font-size: 2rem;
        opacity: 0;
        transform: scale(0.3) rotate(-30deg);
        transition:
            opacity 0.3s ease,
            transform 0.3s ease;
        filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.4));
    }
    .identity-card.selecting .identity-card__badge {
        opacity: 1;
        transform: scale(1) rotate(0deg);
    }

    .identity-card.selecting .identity-card__frame {
        animation: dust-spin 0.6s ease-out forwards;
    }
    @keyframes dust-spin {
        0% {
            transform: rotate(0deg) scale(1);
        }
        40% {
            transform: rotate(360deg) scale(1.18);
            filter: blur(0.5px);
        }
        100% {
            transform: rotate(360deg) scale(1.3);
            opacity: 0.85;
        }
    }

    .identity-picker__cards.has-selection .identity-card:not(.selecting) {
        opacity: 0.25;
        filter: grayscale(1);
        transition:
            opacity 0.4s ease,
            filter 0.4s ease;
        pointer-events: none;
    }

    @media (max-width: 600px) {
        .identity-scene__cactus {
            width: 45px;
        }
        .identity-card {
            width: 140px;
        }
        .identity-card__frame {
            width: 130px;
            height: 130px;
        }
    }
</style>

<script>
    import { DIVAS_PROFILES, setCurrentUser } from "../utils/identity";

    // astro:page-load se dispara en la carga inicial y en cada navegación
    // por View Transitions; salimos si esta página no tiene selector.
    document.addEventListener("astro:page-load", () => {
        const container = document.getElementById("identity-cards");
        if (!container) return;

        container.innerHTML = DIVAS_PROFILES.map(
            (profile) => `
    <div class="identity-card" data-name="${profile.name}" role="button" tabindex="0" aria-label="Elegir a ${profile.name}">
      <div class="identity-card__frame">
        <img src="${profile.avatar}" alt="${profile.name}" width="170" height="170" />
        <span class="identity-card__badge">⭐</span>
      </div>
      <div class="identity-card__label">
        <h3>${profile.name}</h3>
        <p>${profile.tagline}</p>
      </div>
    </div>
  `,
        ).join("");

        function selectCard(card: HTMLElement) {
            if (container!.classList.contains("has-selection")) return;

            const name = card.dataset.name!;

            container!.classList.add("has-selection");
            card.classList.add("selecting");

            setTimeout(() => {
                setCurrentUser(name);
                const redirectTo =
                    sessionStorage.getItem("identity-redirect") || "/";
                sessionStorage.removeItem("identity-redirect");
                window.location.href = redirectTo;
            }, 650);
        }

        container.addEventListener("click", (e) => {
            const card = (e.target as HTMLElement).closest(
                ".identity-card",
            ) as HTMLElement;
            if (!card) return;
            selectCard(card);
        });

        container.addEventListener("keydown", (e) => {
            if (e.key !== "Enter" && e.key !== " ") return;
            const card = (e.target as HTMLElement).closest(
                ".identity-card",
            ) as HTMLElement;
            if (!card) return;
            e.preventDefault();
            selectCard(card);
        });
    });
</script>
