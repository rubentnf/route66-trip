---
import { ClientRouter } from "astro:transitions";
import { getDaysWithDetails } from "../utils/dayDetails";
import { locations } from "../data/trip";
import TripMap from "../components/TripMap.astro";

const daysWithDetails = await getDaysWithDetails();
const totalKm = daysWithDetails.reduce((sum, d) => sum + (d.distanceKm ?? 0), 0);

let running = 0;
const cumulativeKmByDayId: Record<number, number> = {};
for (const { day, distanceKm } of daysWithDetails) {
    running += distanceKm ?? 0;
    cumulativeKmByDayId[day.id] = running;
}

const locById = new Map(locations.map((l) => [l.id, l]));

const photoColor: Record<string, string> = {
    purple: "linear-gradient(135deg, #a78bfa, #7c3aed)",
    green: "linear-gradient(135deg, #86efac, #16a34a)",
    orange: "linear-gradient(135deg, #f6a35c, #c2410c)",
    blue: "linear-gradient(135deg, #93c5fd, #2563eb)",
    red: "linear-gradient(135deg, #fca5a5, #dc2626)",
    yellow: "linear-gradient(135deg, #fde68a, #ca8a04)",
    brown: "linear-gradient(135deg, #d6b48a, #78350f)",
    teal: "linear-gradient(135deg, #7dd3c8, #0d9488)",
};

const emojiByGroup: Record<string, string> = {
    purple: "🌉", green: "🌲", orange: "🏜️", blue: "🏞️",
    red: "🪨", yellow: "🦅", brown: "🛣️", teal: "🌊",
};
---

<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Divas en Ruta · App</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    />
    <ClientRouter />
</head>
<body>
    <div id="days-data" data-days={JSON.stringify(daysWithDetails)} data-cumkm={JSON.stringify(cumulativeKmByDayId)} data-totalkm={totalKm} hidden></div>

    <div class="wrap">
        <div class="topbar">
            <span class="logo">Divas en Ruta</span>
            <div class="stats">
                <div class="stat"><small>Hoy</small><strong id="stat-today">—</strong></div>
                <div class="stat"><small>Próxima parada</small><strong id="stat-next">—</strong></div>
                <div class="stat"><small>Recorridos</small><strong id="stat-km">—</strong></div>
            </div>
        </div>

        <div class="cats">
            <a class="cat" href="#itinerario"><div class="cat__icon" style="background:#e8f3ee;">🗺️</div><small>Itinerario</small></a>
            <a class="cat" href="#mapa"><div class="cat__icon" style="background:#fdeee0;">📍</div><small>Mapa</small></a>
            <a class="cat" href="/playlist"><div class="cat__icon" style="background:#eaf1fc;">🎵</div><small>Playlist</small></a>
            <a class="cat" href="/emergencia"><div class="cat__icon" style="background:#f2ecfb;">🆘</div><small>Emergencias</small></a>
        </div>

        <div class="stepper-card">
            <h4>Fase del viaje</h4>
            <div class="steps">
                <div class="step" id="step-a">1</div>
                <div class="line" id="line-a"></div>
                <div class="step todo" id="step-b">·</div>
                <div class="line todo" id="line-b"></div>
                <div class="step todo" id="step-c">16</div>
            </div>
            <div class="steps-labels"><span>Antes</span><span>Durante</span><span>Después</span></div>
            <div class="summary-row"><span>Días recorridos</span><strong id="sum-days">—</strong></div>
            <div class="summary-row"><span>Km hasta hoy</span><strong id="sum-km">—</strong></div>
            <div class="summary-row"><span>Km totales del viaje</span><strong>{totalKm.toLocaleString("es-ES")} km</strong></div>
        </div>

        <h2 class="section-title" id="itinerario">Itinerario completo</h2>
        <div class="grid">
            {daysWithDetails.map(({ day, weather, warning, sun, distanceKm, funFact }) => {
                const loc = locById.get(day.locationId);
                const group = loc?.colorGroup ?? "blue";
                return (
                    <article class="detail" id={`day-${day.id}`}>
                        <div class="detail__photo" style={`background:${photoColor[group] ?? photoColor.blue}`}>
                            {emojiByGroup[group] ?? "📍"}
                        </div>
                        <div class="detail__body">
                            <div class="detail__title">
                                <h3>Día {day.id} · {day.title}</h3>
                                {weather && <span>{Math.round(weather.tempMax)}°</span>}
                            </div>
                            <div class="detail__meta">
                                <div>Día<strong>{new Date(day.date).toLocaleDateString("es-ES", { day: "2-digit", month: "short" })}</strong></div>
                                {distanceKm !== undefined && <div>Km<strong>{distanceKm} km</strong></div>}
                                {sun && <div>Sol<strong>{sun.sunrise}–{sun.sunset}</strong></div>}
                                {weather && <div>Origen<strong>{weather.source === "forecast" ? "previsión" : "histórico"}</strong></div>}
                            </div>
                            {warning && <p class="detail__warning">{warning.icon} {warning.message}</p>}
                            {funFact && <p class="detail__desc">{funFact}</p>}
                            <div class="detail__acts">
                                {day.activities.map((act, i) => (
                                    <div class="act"><span class="act__dot">{i + 1}</span> {act}</div>
                                ))}
                            </div>
                            {day.overnight && <p class="detail__overnight">🌙 {day.overnight}</p>}
                        </div>
                    </article>
                );
            })}
        </div>

        <h2 class="section-title" id="mapa">Ruta en el mapa</h2>
        <div class="map-frame"><TripMap /></div>

        <footer class="colophon">Divas en Ruta · versión app, con los 16 días reales</footer>
    </div>

    <nav class="navbar">
        <a class="on" href="#itinerario">🗺️</a>
        <a href="/playlist">🎵</a>
        <a href="/emergencia">🆘</a>
        <a href="/identidad">🤠</a>
    </nav>

    <script>
        import { mountPhaseWidget } from "../utils/tripDate";
        import { days, locations } from "../data/trip";

        interface DayDetail {
            day: { id: number; locationId: string; title: string };
        }

        const dataEl = document.getElementById("days-data") as HTMLElement;
        const cumulativeKmByDayId: Record<string, number> = JSON.parse(dataEl.dataset.cumkm ?? "{}");
        const totalKm = Number(dataEl.dataset.totalkm ?? 0);

        const statToday = document.getElementById("stat-today")!;
        const statNext = document.getElementById("stat-next")!;
        const statKm = document.getElementById("stat-km")!;
        const stepA = document.getElementById("step-a")!;
        const stepB = document.getElementById("step-b")!;
        const stepC = document.getElementById("step-c")!;
        const lineA = document.getElementById("line-a")!;
        const lineB = document.getElementById("line-b")!;
        const sumDays = document.getElementById("sum-days")!;
        const sumKm = document.getElementById("sum-km")!;

        function nextStopName(afterDayId: number): string {
            const currentLoc = days.find((d) => d.id === afterDayId)?.locationId;
            const next = days.find((d) => d.id > afterDayId && d.locationId !== currentLoc);
            if (!next) return "Fin del viaje";
            return locations.find((l) => l.id === next.locationId)?.name ?? "—";
        }

        mountPhaseWidget((phase) => {
            if (phase.status === "before") {
                statToday.textContent = `Faltan ${phase.daysLeft}d`;
                statNext.textContent = locations.find((l) => l.id === days[0].locationId)?.name ?? "—";
                statKm.textContent = `${totalKm} km`;
                stepB.classList.add("todo");
                stepB.textContent = "·";
                lineA.classList.add("todo");
                sumDays.textContent = `0 de ${days.length}`;
                sumKm.textContent = "0 km";
            } else if (phase.status === "during") {
                statToday.textContent = `Día ${phase.today.id}`;
                statNext.textContent = nextStopName(phase.today.id);
                const km = cumulativeKmByDayId[phase.today.id] ?? 0;
                statKm.textContent = `${km} km`;
                stepB.classList.remove("todo");
                stepB.textContent = String(phase.today.id);
                lineA.classList.remove("todo");
                sumDays.textContent = `${phase.today.id} de ${days.length}`;
                sumKm.textContent = `${km} km`;
            } else {
                statToday.textContent = "Completado";
                statNext.textContent = "—";
                statKm.textContent = `${totalKm} km`;
                stepB.classList.remove("todo");
                stepB.textContent = "✓";
                lineA.classList.remove("todo");
                lineB.classList.remove("todo");
                stepC.classList.remove("todo");
                sumDays.textContent = `${days.length} de ${days.length}`;
                sumKm.textContent = `${totalKm} km`;
            }
        });
    </script>

    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: "Plus Jakarta Sans", -apple-system, "Segoe UI", sans-serif;
            background: #f7f8fb;
            color: #16233e;
            padding-bottom: 5rem;
        }
        a { color: inherit; text-decoration: none; }

        .wrap { max-width: 1040px; margin: 0 auto; padding: 1.6rem 1.25rem 3rem; }

        .topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.4rem; flex-wrap: wrap; gap: 0.7rem; }
        .logo { font-weight: 800; font-size: 1.3rem; }
        .stats { display: flex; gap: 0.7rem; flex-wrap: wrap; }
        .stat { background: #fff; border: 1px solid #ececec; border-radius: 12px; padding: 0.5rem 0.9rem; text-align: center; }
        .stat small { display: block; font-size: 0.64rem; color: #8b93a6; }
        .stat strong { display: block; font-size: 0.86rem; color: #2f6fed; }

        .cats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.9rem; margin-bottom: 1.6rem; }
        .cat { text-align: center; }
        .cat__icon { width: 56px; height: 56px; border-radius: 18px; margin: 0 auto 0.4rem; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; }
        .cat small { font-size: 0.74rem; font-weight: 700; }

        .stepper-card { background: #fff; border: 1px solid #ececec; border-radius: 22px; padding: 1.3rem; margin-bottom: 2.4rem; }
        .stepper-card h4 { margin: 0 0 1rem; font-size: 0.92rem; }
        .steps { display: flex; align-items: center; margin-bottom: 1rem; }
        .step { width: 30px; height: 30px; border-radius: 50%; background: #2f6fed; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.74rem; font-weight: 800; flex-shrink: 0; }
        .step.todo { background: #e6e9f0; color: #9aa3b5; }
        .steps .line { flex: 1; height: 2px; background: #2f6fed; }
        .steps .line.todo { background: #e6e9f0; }
        .steps-labels { display: flex; justify-content: space-between; font-size: 0.7rem; color: #8b93a6; margin-bottom: 1.1rem; }
        .summary-row { display: flex; justify-content: space-between; font-size: 0.86rem; padding: 0.55rem 0; border-bottom: 1px solid #f0f0f0; }
        .summary-row:last-child { border-bottom: none; }
        .summary-row strong { font-weight: 700; }

        .section-title { font-size: 1.15rem; font-weight: 800; margin: 0 0 1.1rem; scroll-margin-top: 1rem; }

        .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.2rem; margin-bottom: 3rem; }
        @media (max-width: 760px) { .grid { grid-template-columns: 1fr; } }

        .detail { background: #fff; border: 1px solid #ececec; border-radius: 22px; overflow: hidden; scroll-margin-top: 1rem; }
        .detail__photo { height: 110px; display: flex; align-items: flex-end; padding: 0.8rem; font-size: 1.8rem; }
        .detail__body { padding: 1.15rem; }
        .detail__title { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.6rem; gap: 0.6rem; }
        .detail__title h3 { margin: 0; font-size: 1rem; }
        .detail__title span { font-weight: 800; color: #2f6fed; font-size: 1rem; flex-shrink: 0; }

        .detail__meta { display: flex; gap: 1rem; margin-bottom: 0.7rem; flex-wrap: wrap; }
        .detail__meta div { font-size: 0.66rem; color: #8b93a6; }
        .detail__meta strong { display: block; font-size: 0.76rem; color: #16233e; font-weight: 700; }

        .detail__warning { background: #fff2e2; border-left: 3px solid #d97706; padding: 0.5rem 0.7rem; border-radius: 0 8px 8px 0; font-size: 0.76rem; font-weight: 600; color: #92400e; margin: 0 0 0.7rem; }
        .detail__desc { font-size: 0.78rem; color: #6b7284; margin: 0 0 0.9rem; line-height: 1.5; }

        .detail__acts { display: flex; flex-direction: column; gap: 0.45rem; margin-bottom: 0.9rem; }
        .act { display: flex; align-items: flex-start; gap: 0.5rem; font-size: 0.78rem; }
        .act__dot { width: 20px; height: 20px; border-radius: 50%; background: #eaf1fc; color: #2f6fed; display: flex; align-items: center; justify-content: center; font-size: 0.6rem; flex-shrink: 0; font-weight: 700; margin-top: 0.05rem; }

        .detail__overnight { margin: 0; padding-top: 0.7rem; border-top: 1px solid #f0f0f0; font-size: 0.76rem; color: #8b93a6; }

        .map-frame { height: 420px; border-radius: 22px; overflow: hidden; border: 1px solid #ececec; margin-bottom: 2rem; scroll-margin-top: 1rem; }

        footer.colophon { text-align: center; font-size: 0.78rem; color: #8b93a6; }

        .navbar {
            position: fixed; left: 50%; bottom: 1rem; transform: translateX(-50%);
            display: flex; gap: 0.3rem; background: #fff; border: 1px solid #ececec; border-radius: 999px;
            padding: 0.5rem; box-shadow: 0 12px 30px -14px rgba(22,35,62,0.3); z-index: 20;
        }
        .navbar a { width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.05rem; }
        .navbar a.on { background: #2f6fed; }
    </style>
</body>
</html>
