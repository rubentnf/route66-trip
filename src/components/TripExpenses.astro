<div class="expenses">
    <div class="expenses__summary">
        <div class="expenses__total">
            <span class="expenses__total-label">Total del viaje</span>
            <span class="expenses__total-amount" id="total-amount">0€</span>
        </div>
        <div class="expenses__balance-row" id="balance-row"></div>
    </div>

    <div class="expenses__settle" id="settle-section"></div>

    <button id="toggle-form-btn" class="expenses__toggle-btn"
        >+ Añadir gasto</button
    >

    <form id="expense-form" class="expenses__form" hidden>
        <input
            type="text"
            id="expense-desc"
            placeholder="¿En qué os lo gastasteis?"
            required
        />

        <div class="expenses__row">
            <input
                type="number"
                id="expense-amount"
                placeholder="0.00 €"
                step="0.01"
                min="0.01"
                required
            />
            <select id="expense-category"></select>
        </div>

        <div class="expenses__field">
            <label>Pagado por</label>
            <div id="expense-paid-by" class="expenses__avatar-select"></div>
        </div>

        <div class="expenses__field">
            <label>Se reparte entre</label>
            <div id="expense-participants" class="expenses__avatar-select">
            </div>
        </div>

        <button type="submit">Guardar gasto</button>
    </form>

    <ul id="expense-list" class="expenses__list"></ul>
</div>

<style is:global>
    .expenses {
        padding: 1.25rem;
        background: white;
        border: 1px solid #e2e2e2;
        border-radius: 12px;
        margin-bottom: 1.5rem;
    }

    .expenses__summary {
        background: var(--color-sand);
        border-radius: 10px;
        padding: 1rem 1.25rem;
        margin-bottom: 1rem;
    }
    .expenses__total {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 0.85rem;
        padding-bottom: 0.85rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    }
    .expenses__total-label {
        font-size: 0.78rem;
        color: #78716c;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }
    .expenses__total-amount {
        font-family: var(--font-display);
        font-size: 1.5rem;
        color: var(--color-navy);
    }
    .expenses__balance-row {
        display: flex;
        gap: 0.9rem;
        flex-wrap: wrap;
    }
    .balance-person {
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }
    .balance-person img {
        width: 30px;
        height: 30px;
        min-width: 30px;
        border-radius: 50%;
        object-fit: cover;
        display: block;
    }
    .balance-person__info {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
    }
    .balance-person__name {
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--color-navy);
    }
    .balance-person__amount {
        font-size: 0.72rem;
        font-weight: 600;
    }
    .balance-person__amount--positive {
        color: #16a34a;
    }
    .balance-person__amount--negative {
        color: #dc2626;
    }
    .balance-person__amount--zero {
        color: #94a3b8;
    }

    .expenses__settle {
        margin-bottom: 1rem;
    }
    .settle-card {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: #fff7ed;
        border: 1px solid #fed7aa;
        border-radius: 8px;
        padding: 0.5rem 0.75rem;
        margin-bottom: 0.4rem;
        font-size: 0.8rem;
    }
    .settle-card img {
        width: 22px;
        height: 22px;
        min-width: 22px;
        border-radius: 50%;
        object-fit: cover;
        display: block;
    }
    .settle-card .arrow {
        color: var(--color-rust);
        font-weight: 700;
        font-size: 0.75rem;
    }
    .settle-card .amount {
        margin-left: auto;
        font-weight: 700;
        color: var(--color-rust);
    }
    .settle-empty {
        text-align: center;
        color: #94a3b8;
        font-size: 0.8rem;
        padding: 0.4rem;
    }

    .expenses__toggle-btn {
        width: 100%;
        padding: 0.6rem;
        background: var(--color-rust);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        margin-bottom: 1rem;
    }
    .expenses__form {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
        margin-bottom: 1.25rem;
        padding: 0.9rem;
        background: var(--color-sand);
        border-radius: 10px;
    }
    .expenses__form input,
    .expenses__form select {
        padding: 0.5rem 0.6rem;
        border: 1px solid #d6d3d1;
        border-radius: 6px;
        font-size: 0.9rem;
        background: white;
    }
    .expenses__row {
        display: flex;
        gap: 0.5rem;
    }
    .expenses__row input {
        flex: 1.2;
    }
    .expenses__row select {
        flex: 1;
    }
    .expenses__field label {
        display: block;
        font-size: 0.72rem;
        font-weight: 600;
        margin-bottom: 0.35rem;
        color: #78716c;
        text-transform: uppercase;
        letter-spacing: 0.02em;
    }
    .expenses__avatar-select {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }
    .avatar-pick {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.2rem;
        cursor: pointer;
        opacity: 0.35;
        transition: opacity 0.15s ease;
    }
    .avatar-pick img {
        width: 34px;
        height: 34px;
        min-width: 34px;
        border-radius: 50%;
        object-fit: cover;
        display: block;
        border: 2px solid transparent;
    }
    .avatar-pick span {
        font-size: 0.65rem;
        font-weight: 600;
        color: var(--color-navy);
    }
    .avatar-pick.active {
        opacity: 1;
    }
    .avatar-pick.active img {
        border-color: var(--color-rust);
    }
    .expenses__form button[type="submit"] {
        padding: 0.6rem;
        background: var(--color-turquoise);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
    }

    .expenses__list {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .expenses__list li {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.6rem 0;
        border-bottom: 1px solid #f1f1f0;
    }
    .expense-icon {
        width: 30px;
        height: 30px;
        min-width: 30px;
        border-radius: 50%;
        background: var(--color-sand);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
    }
    .expense-info {
        flex: 1;
        min-width: 0;
    }
    .expense-info strong {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--color-navy);
    }
    .expense-info .expense-meta {
        font-size: 0.72rem;
        color: #94a3b8;
        display: flex;
        align-items: center;
        gap: 0.3rem;
        margin-top: 0.15rem;
    }
    .expense-meta img {
        width: 16px;
        height: 16px;
        min-width: 16px;
        border-radius: 50%;
        object-fit: cover;
        display: block;
    }
    .expense-amount {
        font-weight: 700;
        font-size: 0.88rem;
        color: var(--color-navy);
        white-space: nowrap;
    }
    .expenses__list button.delete-btn {
        background: none;
        border: none;
        cursor: pointer;
        color: #d1d5db;
        font-size: 0.85rem;
        flex-shrink: 0;
        padding: 0.2rem;
    }
    .expenses__list button.delete-btn:hover {
        color: #dc2626;
    }
</style>

<script>
    import { supabase, subscribeToTable } from "../lib/supabase";
    import { DIVAS, DIVAS_PROFILES, avatarOf, getCurrentUser } from "../utils/identity";
    import { formatEUR } from "../utils/format";

    const CATEGORIES: Record<string, string> = {
        Comida: "🍔",
        Alojamiento: "🏨",
        Transporte: "🚗",
        Ocio: "🎟️",
        Compras: "🛍️",
        Otros: "📦",
    };

    const form = document.getElementById("expense-form") as HTMLFormElement;
    const toggleBtn = document.getElementById(
        "toggle-form-btn",
    ) as HTMLButtonElement;
    const descInput = document.getElementById(
        "expense-desc",
    ) as HTMLInputElement;
    const amountInput = document.getElementById(
        "expense-amount",
    ) as HTMLInputElement;
    const categorySelect = document.getElementById(
        "expense-category",
    ) as HTMLSelectElement;
    const paidByDiv = document.getElementById("expense-paid-by")!;
    const participantsDiv = document.getElementById("expense-participants")!;
    const totalAmountEl = document.getElementById("total-amount")!;
    const balanceRow = document.getElementById("balance-row")!;
    const settleSection = document.getElementById("settle-section")!;
    const list = document.getElementById("expense-list")!;

    toggleBtn.addEventListener("click", () => {
        form.hidden = !form.hidden;
        toggleBtn.textContent = form.hidden ? "+ Añadir gasto" : "✕ Cerrar";
    });

    categorySelect.innerHTML = Object.entries(CATEGORIES)
        .map(
            ([name, icon]) =>
                `<option value="${name}">${icon} ${name}</option>`,
        )
        .join("");

    function renderAvatarOptions(activeNames: string[]): string {
        return DIVAS_PROFILES.map(
            (p) => `
    <div class="avatar-pick${activeNames.includes(p.name) ? " active" : ""}" data-name="${p.name}">
      <img src="${p.avatar}" alt="${p.name}" />
      <span>${p.name}</span>
    </div>
  `,
        ).join("");
    }

    paidByDiv.innerHTML = renderAvatarOptions([]);

    let paidBy = getCurrentUser() ?? DIVAS_PROFILES[0].name;
    function renderPaidBy() {
        paidByDiv.querySelectorAll(".avatar-pick").forEach((el) => {
            el.classList.toggle(
                "active",
                (el as HTMLElement).dataset.name === paidBy,
            );
        });
    }
    paidByDiv.addEventListener("click", (e) => {
        const pick = (e.target as HTMLElement).closest(
            ".avatar-pick",
        ) as HTMLElement;
        if (!pick) return;
        paidBy = pick.dataset.name!;
        renderPaidBy();
    });
    renderPaidBy();

    participantsDiv.innerHTML = renderAvatarOptions(DIVAS);
    participantsDiv.addEventListener("click", (e) => {
        const pick = (e.target as HTMLElement).closest(
            ".avatar-pick",
        ) as HTMLElement;
        if (!pick) return;
        pick.classList.toggle("active");
    });

    type ExpenseRow = {
        id: string;
        description: string;
        amount: number;
        paid_by: string;
        category: string;
        created_at: string;
        expense_participants: { participant: string }[];
    };

    async function loadExpenses() {
        const { data, error } = await supabase
            .from("expenses")
            .select("*, expense_participants(participant)")
            .order("created_at", { ascending: false });

        if (error) {
            console.error("Error cargando gastos:", error);
            return;
        }
        const expenses = (data ?? []) as ExpenseRow[];
        renderTotal(expenses);
        renderBalances(expenses);
        renderExpenses(expenses);
    }

    function renderTotal(expenses: ExpenseRow[]) {
        const total = expenses.reduce((sum, e) => sum + e.amount, 0);
        totalAmountEl.textContent = formatEUR(total);
    }

    function renderExpenses(expenses: ExpenseRow[]) {
        list.innerHTML = expenses
            .map((exp) => {
                const icon = CATEGORIES[exp.category] ?? "📦";
                const date = new Date(exp.created_at).toLocaleDateString(
                    "es-ES",
                    { day: "2-digit", month: "short" },
                );
                return `
        <li data-id="${exp.id}">
          <div class="expense-icon">${icon}</div>
          <div class="expense-info">
            <strong>${exp.description}</strong>
            <div class="expense-meta">
              <img src="${avatarOf(exp.paid_by)}" alt="${exp.paid_by}" />
              ${exp.paid_by} · ${date}
            </div>
          </div>
          <div class="expense-amount">${formatEUR(exp.amount)}</div>
          <button class="delete-btn" title="Eliminar">✕</button>
        </li>
      `;
            })
            .join("");
    }

    function renderBalances(expenses: ExpenseRow[]) {
        const names = DIVAS;
        const paid: Record<string, number> = {};
        const owed: Record<string, number> = {};
        names.forEach((n) => {
            paid[n] = 0;
            owed[n] = 0;
        });

        for (const exp of expenses) {
            paid[exp.paid_by] = (paid[exp.paid_by] ?? 0) + exp.amount;
            const participants = exp.expense_participants.map(
                (p) => p.participant,
            );
            if (participants.length === 0) continue;
            const share = exp.amount / participants.length;
            for (const p of participants) owed[p] = (owed[p] ?? 0) + share;
        }

        const net: Record<string, number> = {};
        names.forEach((n) => {
            net[n] = (paid[n] ?? 0) - (owed[n] ?? 0);
        });

        balanceRow.innerHTML = names
            .map((name) => {
                const amount = net[name];
                const cls =
                    amount > 0.01
                        ? "positive"
                        : amount < -0.01
                          ? "negative"
                          : "zero";
                const label =
                    amount > 0.01
                        ? `+${formatEUR(amount)}`
                        : amount < -0.01
                          ? formatEUR(amount)
                          : "0€";
                return `
        <div class="balance-person">
          <img src="${avatarOf(name)}" alt="${name}" />
          <div class="balance-person__info">
            <span class="balance-person__name">${name}</span>
            <span class="balance-person__amount balance-person__amount--${cls}">${label}</span>
          </div>
        </div>
      `;
            })
            .join("");

        const settlements = simplifyDebts({ ...net });
        settleSection.innerHTML =
            settlements.length > 0
                ? settlements
                      .map(
                          (s) => `
          <div class="settle-card">
            <img src="${avatarOf(s.from)}" alt="${s.from}" />
            <span>${s.from}</span>
            <span class="arrow">→</span>
            <img src="${avatarOf(s.to)}" alt="${s.to}" />
            <span>${s.to}</span>
            <span class="amount">${formatEUR(s.amount)}</span>
          </div>
        `,
                      )
                      .join("")
                : '<p class="settle-empty">🎉 Todo saldado</p>';
    }

    function simplifyDebts(
        net: Record<string, number>,
    ): { from: string; to: string; amount: number }[] {
        const settlements: { from: string; to: string; amount: number }[] = [];
        const EPSILON = 0.01;

        let debtors = Object.entries(net)
            .filter(([, v]) => v < -EPSILON)
            .map(([name, v]) => ({ name, amount: -v }));
        let creditors = Object.entries(net)
            .filter(([, v]) => v > EPSILON)
            .map(([name, v]) => ({ name, amount: v }));

        debtors.sort((a, b) => b.amount - a.amount);
        creditors.sort((a, b) => b.amount - a.amount);

        let i = 0,
            j = 0;
        while (i < debtors.length && j < creditors.length) {
            const debtor = debtors[i];
            const creditor = creditors[j];
            const amount = Math.min(debtor.amount, creditor.amount);

            settlements.push({ from: debtor.name, to: creditor.name, amount });

            debtor.amount -= amount;
            creditor.amount -= amount;

            if (debtor.amount < EPSILON) i++;
            if (creditor.amount < EPSILON) j++;
        }

        return settlements;
    }

    form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const description = descInput.value.trim();
        const amount = parseFloat(amountInput.value);
        const category = categorySelect.value;
        const activeParticipants = participantsDiv.querySelectorAll(
            ".avatar-pick.active",
        );
        const participants = Array.from(activeParticipants).map(
            (el) => (el as HTMLElement).dataset.name!,
        );

        if (!description || !amount || participants.length === 0) return;

        const { data: newExpense, error: expenseError } = await supabase
            .from("expenses")
            .insert({ description, amount, paid_by: paidBy, category })
            .select()
            .single();

        if (expenseError || !newExpense) {
            console.error("Error creando gasto:", expenseError);
            return;
        }

        const participantRows = participants.map((p) => ({
            expense_id: newExpense.id,
            participant: p,
        }));
        const { error: participantsError } = await supabase
            .from("expense_participants")
            .insert(participantRows);

        if (participantsError) {
            console.error("Error asociando participantes:", participantsError);
            return;
        }

        form.reset();
        categorySelect.value = "Otros";
        form.hidden = true;
        toggleBtn.textContent = "+ Añadir gasto";
    });

    list.addEventListener("click", async (e) => {
        const target = e.target as HTMLElement;
        if (!target.classList.contains("delete-btn")) return;
        const li = target.closest("li");
        const id = li?.dataset.id;
        if (!id) return;

        const { error } = await supabase.from("expenses").delete().eq("id", id);
        if (error) console.error("Error borrando gasto:", error);
    });

    subscribeToTable("expenses", loadExpenses);
    subscribeToTable("expense_participants", loadExpenses);

    loadExpenses();
</script>
