---
import { getTripRoute } from "../utils/route";

const { roadRoute } = await getTripRoute();
---

<div class="map-wrap">
    <div
        id="trip-map"
        style="height: 100%; width: 100%; border-radius: 12px;"
        data-route={JSON.stringify(roadRoute)}
    >
    </div>
    <div id="map-clock" class="map-clock" hidden>
        <span id="map-clock-place"></span>
        <span id="map-clock-time"></span>
    </div>
</div>

<style is:global>
    @import "leaflet/dist/leaflet.css";

    .trip-marker {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        color: white;
        font-weight: 700;
        font-size: 14px;
        border: 3px solid white;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
    }

    .map-wrap {
        position: relative;
        height: 100%;
        width: 100%;
    }

    .map-clock {
        position: absolute;
        right: 0.75rem;
        bottom: 0.75rem;
        z-index: 1000;
        background: rgba(30, 41, 59, 0.85);
        color: white;
        padding: 0.4rem 0.7rem;
        border-radius: 8px;
        font-family: var(--font-body);
        font-size: 0.75rem;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        line-height: 1.3;
        pointer-events: none;
    }

    .map-clock #map-clock-time {
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 0.02em;
    }

    .trip-marker--active {
        transform: scale(1.3);
        box-shadow:
            0 0 0 4px rgba(0, 0, 0, 0.15),
            0 4px 10px rgba(0, 0, 0, 0.4);
        z-index: 1000 !important;
    }
</style>

<script>
    import L from "leaflet";
    import { locations, days, type TripDay } from "../data/trip";
    import { getTodayTrip } from "../utils/tripDate";
    import { check } from "astro:schema";

    const colorMap: Record<string, string> = {
        purple: "#7c3aed",
        green: "#16a34a",
        orange: "#c2410c",
        blue: "#2563eb",
        red: "#dc2626",
        yellow: "#ca8a04",
        brown: "#78350f",
        teal: "#0d9488",
    };

    function groupDaysByLocation(allDays: TripDay[]) {
        const order: string[] = [];
        const map = new Map<string, TripDay[]>();

        for (const day of allDays) {
            if (!map.has(day.locationId)) {
                map.set(day.locationId, []);
                order.push(day.locationId);
            }
            map.get(day.locationId)!.push(day);
        }
        return { order, map };
    }

    let map: L.Map | undefined;
    let dayActiveHandler: ((e: Event) => void) | undefined;
    let clockIntervalId: ReturnType<typeof setInterval> | undefined;
    let activeLocationForClock: (typeof locations)[number] | undefined;

    function renderClock() {
        const clockEl = document.getElementById("map-clock");
        const placeEl = document.getElementById("map-clock-place");
        const timeEl = document.getElementById("map-clock-time");
        if (!clockEl || !placeEl || !timeEl || !activeLocationForClock) return;

        clockEl.hidden = false;
        placeEl.textContent = activeLocationForClock.name;
        timeEl.textContent = new Intl.DateTimeFormat("es-ES", {
            timeZone: activeLocationForClock.timezone,
            hour: "2-digit",
            minute: "2-digit",
        }).format(new Date());
    }

    function initMap() {
        const mapEl = document.getElementById("trip-map");
        if (!mapEl) return;

        const { order, map: daysByLocation } = groupDaysByLocation(days);

        const mapInstance = L.map("trip-map", {
            scrollWheelZoom: false,
        }).setView([36.5, -116.5], 6);
        map = mapInstance;

        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            attribution: "&copy; OpenStreetMap contributors",
            maxZoom: 12,
        }).addTo(mapInstance);

        const markersByLocation: Record<string, L.Marker> = {};

        order.forEach((locationId) => {
            const location = locations.find((l) => l.id === locationId);
            if (!location) return;

            const groupDays = daysByLocation.get(locationId)!;
            const color = colorMap[location.colorGroup] ?? "#333";

            const label =
                groupDays.length === 1
                    ? `${groupDays[0].id}`
                    : `${groupDays[0].id}-${groupDays[groupDays.length - 1].id}`;

            const icon = L.divIcon({
                className: "",
                html: `<div class="trip-marker" style="background:${color}">${label}</div>`,
                iconSize: [34, 34],
                iconAnchor: [17, 17],
            });

            const popupHtml = `
        <strong>${location.name}</strong>
        <ul style="margin:6px 0 0; padding-left:16px;">
          ${groupDays.map((d) => `<li><a href="#day-${d.id}">Día ${d.id} · ${d.title}</a></li>`).join("")}
        </ul>
        `;

            markersByLocation[locationId] = L.marker(
                [location.lat, location.lng],
                { icon },
            )
                .addTo(mapInstance)
                .bindPopup(popupHtml);
        });

        let roadRoute: [number, number][] = [];
        try {
            roadRoute = JSON.parse(mapEl.dataset.route ?? "[]");
        } catch {
            roadRoute = [];
        }

        L.polyline(roadRoute, {
            color: "#334155",
            weight: 3,
        }).addTo(mapInstance);

        mapInstance.fitBounds(roadRoute, { padding: [40, 40] });

        let activeMarker: L.Marker | null = null;

        dayActiveHandler = (e: Event) => {
            const { locationId } = (e as CustomEvent).detail;
            const location = locations.find((l) => l.id === locationId);
            const marker = markersByLocation[locationId];
            if (!location || !marker) return;

            activeLocationForClock = location;
            renderClock();

            mapInstance.flyTo([location.lat, location.lng], 9, {
                duration: 0.8,
            });

            if (activeMarker)
                activeMarker
                    .getElement()
                    ?.classList.remove("trip-marker--active");
            marker.getElement()?.classList.add("trip-marker--active");
            activeMarker = marker;

            // Tema visual de la parada activa (Vegas neón, desierto...), si tiene uno
            if (location.theme) {
                document.body.dataset.theme = location.theme;
            } else {
                delete document.body.dataset.theme;
            }
        };
        window.addEventListener("trip:day-active", dayActiveHandler);
        clockIntervalId = setInterval(renderClock, 30 * 1000);

        const todayTrip = getTodayTrip();
        if (todayTrip) {
            window.dispatchEvent(
                new CustomEvent("trip:day-active", {
                    detail: { locationId: todayTrip.locationId },
                }),
            );
        }

        mapEl.addEventListener("click", () => {
            if (window.innerWidth > 768) return;
            document.body.classList.toggle("map-expanded");
            setTimeout(() => mapInstance.invalidateSize(), 310);
        });
    }

    // astro:page-load se dispara en la carga inicial y en cada navegación
    // por View Transitions; initMap sale pronto si esta página no tiene map.
    document.addEventListener("astro:page-load", () => {
        initMap();
    });

    document.addEventListener("astro:before-swap", () => {
        if (dayActiveHandler) {
            window.removeEventListener("trip:day-active", dayActiveHandler);
            dayActiveHandler = undefined;
        }
        clearInterval(clockIntervalId);
        map?.remove();
        map = undefined;
        delete document.body.dataset.theme;
        document.body.classList.remove("map-expanded");
    });
</script>
