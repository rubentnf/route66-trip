---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Playlist">
    <div class="playlist-page">
        <h2>🎵 Playlist del viaje</h2>
        <iframe
            style="border-radius:12px"
            src="https://open.spotify.com/embed/playlist/5ZO3rekvFJNOTM2ojGyghN?utm_source=generator&theme=0&si=9b6ec58ba546457a"
            width="100%"
            height="500"
            frameborder="0"
            allowfullscreen
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"></iframe>
    </div>
</BaseLayout>

<style>
    .playlist-page {
        padding: 1.5rem 0;
    }
    .playlist-page iframe {
        max-width: 700px;
        display: block;
        margin: 0 auto;
    }
</style>
