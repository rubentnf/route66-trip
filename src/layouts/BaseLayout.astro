---
import TripStatus from "../components/TripStatus.astro";
import NavBar from "../components/NavBar.astro";

interface Props {
    title: string;
    hideNav?: boolean;
}
const { title, hideNav = false } = Astro.props;
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex, nofollow" />
        <title>{title} · Divas en Ruta</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&family=Work+Sans:wght@400;500;600&display=swap"
            rel="stylesheet"
        />

        <script is:inline>
            (function () {
                const isIdentityPage =
                    window.location.pathname.replace(/\/$/, "") ===
                    "/identidad";
                const hasUser = localStorage.getItem("trip-user");
                if (!hasUser && !isIdentityPage) {
                    sessionStorage.setItem(
                        "identity-redirect",
                        window.location.pathname,
                    );
                    window.location.replace("/identidad");
                }
            })();
        </script>
    </head>
    <body>
        <a href="/" class="site-title"><h1>Divas en Ruta</h1></a>
        {!hideNav && <NavBar />}
        <TripStatus />
        <main>
            <slot />
        </main>
    </body>
</html>

<style is:global>
    :root {
        --color-sand: #f5ead3;
        --color-sand-dark: #e8d9b8;
        --color-navy: #1e293b;
        --color-rust: #c2410c;
        --color-turquoise: #0d9488;
        --color-mustard: #ca8a04;

        --font-display: "Oswald", sans-serif;
        --font-body: "Work Sans", sans-serif;
    }

    .site-title {
        text-decoration: none;
        display: block;
    }
    .site-title h1 {
        cursor: pointer;
    }

    body {
        background: var(--color-sand);
        color: var(--color-navy);
        font-family: var(--font-body);
        margin: 0;
    }

    h1,
    h2,
    h3 {
        font-family: var(--font-display);
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    h1 {
        padding: 1.5rem;
        margin: 0;
        color: var(--color-rust);
        border-bottom: 4px solid var(--color-rust);
        background: var(--color-sand-dark);
    }

    main {
        padding: 0 1rem 2rem;
    }

    .trip-layout {
        display: grid;
        gap: 1.5rem;
    }
    .map-slot {
        position: sticky;
        top: 0;
        z-index: 10;
        height: 45vh;
        min-height: 260px;
        max-height: 400px;
        transition: height 0.3s ease;
        cursor: pointer;
        overflow: hidden;
        border: 3px solid var(--color-navy);
        border-radius: 12px;
        margin-top: 1rem;
    }
    .map-slot #trip-map {
        height: 100% !important;
    }
    body.map-expanded .map-slot {
        height: 70vh;
    }

    @media (min-width: 769px) {
        .trip-layout {
            grid-template-columns: 1fr 1fr;
            align-items: start;
        }
        .map-slot {
            height: auto;
            position: sticky;
            top: 1rem;
            cursor: default;
        }
        .map-slot #trip-map {
            height: calc(100vh - 2rem) !important;
        }
    }

    .day-card {
        scroll-margin-top: 160px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        background: white;
        border: 2px solid var(--color-navy);
        border-radius: 8px;
        box-shadow: 4px 4px 0 var(--color-navy);
        position: relative;
    }
    .day-card__header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 0.75rem;
    }
    .day-card__badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--color-rust);
        color: white;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.1rem;
        flex-shrink: 0;
        border: 3px solid var(--color-navy);
    }
    .day-card__badge--route66 {
        background: var(--color-mustard);
        font-size: 1.3rem;
    }
    .day-card__date {
        margin: 0;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-turquoise);
        font-weight: 600;
    }
    .day-card h3 {
        margin: 0;
        font-size: 1.2rem;
    }
    .day-card ul {
        margin: 0;
        padding-left: 1.2rem;
    }
    .day-card__overnight {
        margin-top: 0.75rem;
        font-weight: 600;
        color: var(--color-navy);
    }
    .day-card--today {
        border-color: var(--color-turquoise);
        border-width: 3px;
        box-shadow: 4px 4px 0 var(--color-turquoise);
    }
    .day-card:not(:last-child)::after {
        content: "";
        display: block;
        height: 3px;
        background: repeating-linear-gradient(
            90deg,
            var(--color-mustard) 0px,
            var(--color-mustard) 12px,
            transparent 12px,
            transparent 24px
        );
        margin-top: 1.5rem;
    }

    body.theme-vegas {
        --color-sand: #0f0a1e;
        --color-sand-dark: #1a1030;
        --color-navy: #f5f0ff;
        --color-rust: #ff2d95;
        --color-turquoise: #00e5ff;
        --color-mustard: #ffd60a;
        transition:
            background 0.6s ease,
            color 0.6s ease;
    }
    body.theme-vegas .day-card {
        background: #170f2e;
        box-shadow:
            4px 4px 0 var(--color-rust),
            0 0 20px rgba(255, 45, 149, 0.15);
    }
    body.theme-vegas .day-card--today {
        box-shadow:
            4px 4px 0 var(--color-turquoise),
            0 0 24px rgba(0, 229, 255, 0.35);
    }
    body.theme-vegas h1 {
        text-shadow: 0 0 12px var(--color-rust);
    }

    @media (max-width: 768px) {
        body.theme-vegas .map-slot .leaflet-tile-pane {
            filter: saturate(1.9) hue-rotate(220deg) brightness(0.55)
                contrast(1.25);
            transition: filter 0.6s ease;
        }
        body.theme-vegas .map-slot {
            box-shadow:
                0 0 18px var(--color-rust),
                0 0 8px var(--color-turquoise) inset;
            transition: box-shadow 0.6s ease;
        }
    }
</style>
